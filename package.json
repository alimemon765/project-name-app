{
  "name": "coastal-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:local": "sh scripts/db/local-setup.sh",
    "ingest:papers": "tsx --env-file=.env.local workers/ingest-papers.ts",
    "tokens": "python3 scripts/design/write_tokens.py && python3 scripts/design/build_tokens_css.py --app src/styles/tokens.css && sh scripts/design/check_contrast.sh",
    "backfill:papers": "tsx --env-file=.env.local workers/backfill-papers.ts",
    "ingest:preprints": "tsx --env-file=.env.local workers/ingest-preprints.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-xml-parser": "5.11.2",
    "idb-keyval": "6.3.0",
    "kysely": "0.29.7",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "license": "AGPL-3.0-only"
}
