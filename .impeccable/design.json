 "narrative": {
  "northStar": "The Tide Ledger",
  "overview": "New research arrives in tides, every few hours, from 130 journals. This interface is the ledger a careful researcher keeps of what came in: ink on fog, entries on plain white cards, and exactly one coloured mark for the only thing that changes between visits, what is new. It is a working tool for daily use, so precision and restraint carry the identity, not decoration.\n\nDensity is medium: about two and a half papers per phone screen, every title set in a reading serif so it can be scanned rather than decoded. Topics are a data code, not a palette: thirteen fixed slots, each with its own shape and hue, so a paper's research areas can be read at a glance and never by colour alone. It must never resemble the reference app it rebuilds: no dark-teal default, no mascot, no coloured bar down the side of a card.",
  "keyCharacteristics": [
   "Ink chrome on a fog ground; white cards with a 1px hairline, no shadows at rest",
   "One data hue (Tide Mark Blue) reserved for new-since-last-visit",
   "Serif titles (Newsreader), sans interface (Geist), mono only for DOIs (Geist Mono)",
   "The 13-slot topic register: fixed position + shape + hue + name",
   "Light and dark are equal; dark is designed, not inverted"
  ],
  "rules": [
   {
    "name": "The One Tide Rule",
    "body": "The accent marks only what is new since the last visit: the new dot, the new count, the left-off line. Never a button, never a link, never decoration.",
    "section": "colors"
   },
   {
    "name": "The Shape-and-Word Rule",
    "body": "A topic is always shown with its shape and, where space allows, its name. Colour alone never carries a topic.",
    "section": "colors"
   },
   {
    "name": "The Honest Zero Rule",
    "body": "Zeros print as zeros in muted ink; missing values are a dash; nothing is styled as a signal unless it is one.",
    "section": "colors"
   },
   {
    "name": "The Serif-Is-For-Papers Rule",
    "body": "Newsreader sets paper titles and nothing else in the interface. Tools, settings and labels are Geist.",
    "section": "typography"
   },
   {
    "name": "The Flat-At-Rest Rule",
    "body": "Nothing at rest casts a shadow. Elevation exists only for what floats: sheets, popovers, toasts.",
    "section": "elevation"
   }
  ],
  "dos": [
   "Do use role tokens (bg-surface, text-text-muted), never hex in components.",
   "Do show a retraction first, in plain words, wherever the paper appears.",
   "Do keep every touch target at least 44px and every input at 16px.",
   "Do put the primary action on the visible bottom edge of any sheet.",
   "Do format every number with Intl (separators, plurals) and tabular figures."
  ],
  "donts": [
   "Don't use the accent for buttons, links, selection or emphasis.",
   "Don't add shadows, gradients, glass or glows to resting surfaces.",
   "Don't truncate dates, counts or DOIs; wrap them.",
   "Don't use a coloured left bar on cards, a dark-teal theme, or a mascot.",
   "Don't animate content in: motion is feedback (press, sheets, toasts) only."
  ]
 }
}