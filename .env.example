# Copy to .env.local and fill in. Never commit .env.local.
# Postgres connection (local dev: see scripts/db/local-setup.sh; later Supabase pooler URL)
DATABASE_URL=postgres://postgres@localhost:55433/coastal
# OpenAlex: free key from https://openalex.org/settings/api (works keyless at $0.10/day for the dev slice)
OPENALEX_API_KEY=
# Polite-pool contact for Crossref/OpenAlex/Unpaywall User-Agent
CONTACT_EMAIL=
# No spend figure here: ingest pauses at 80% of the daily limit OpenAlex reports in its response headers (D042).
