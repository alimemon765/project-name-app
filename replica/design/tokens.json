  },
  "abstract": {
   "size": 16,
   "line": 26,
   "weight": 400,
   "family": "sans"
  },
  "card-title": {
   "size": 18,
   "line": 24,
   "weight": 500,
   "family": "title"
  },
  "h1": {
   "size": 22,
   "line": 28,
   "weight": 700,
   "family": "sans"
  },
  "sheet-title": {
   "size": 24,
   "line": 30,
   "weight": 500,
   "family": "title",
   "tracking": "-0.01em"
  },
  "_wrap": {
   "titles": "text-wrap: balance",
   "abstract": "text-wrap: pretty",
   "measure": "abstract max 68ch"
  },
  "_dark": "light-on-dark: +0.005em tracking on body/small, abstract line +1px (handled in tokens.css)",
  "_roles": "meta 12/500 (counts, labels) and small 13/400 muted (authors) are separated by weight and tone, not size alone"
