  0,
  4,
  8,
  12,
  16,
  24,
  32,
  48,
  64
 ],
 "radius": {
  "chip": 6,
  "control": 8,
  "card": 8,
  "pop": 12,
  "sheet": 16,
  "pill": 999
 },
 "elevation": {
  "rest": "none",
  "float-light": "0 -8px 28px rgba(10,12,16,.12)",
  "float-dark": "0 -8px 28px rgba(0,0,0,.50)",
  "pop-light": "0 12px 32px rgba(10,12,16,.14)",
  "pop-dark": "0 12px 32px rgba(0,0,0,.55)",
  "_rule": "Nothing at rest casts a shadow. Only what floats: sheets, popovers, toasts."
 },
 "scrim-opacity": {
  "light": 0.3,
  "dark": 0.55
 },
 "motion": {
  "duration": {
   "press": "120ms",
   "fast": "150ms",
   "base": "200ms",
   "slow": "300ms"
  },
  "ease": {
   "out": "cubic-bezier(0.23, 1, 0.32, 1)",
   "in-out": "cubic-bezier(0.77, 0, 0.175, 1)",
   "drawer": "cubic-bezier(0.32, 0.72, 0, 1)"
  },
  "spring": {
   "sheet-open": {
    "damping": 1.0,
    "response": 0.38
   },
   "sheet-close": {
    "damping": 1.0,
    "response": 0.3
   },
   "sheet-flick": {
    "damping": 0.8,
    "response": 0.32,
    "_when": "release velocity > 600px/s"
   },
   "settle": {
    "damping": 1.0,
    "response": 0.35
   }
  },
  "press-scale": {
   "button": 0.97,
   "icon": 0.94,
   "primary": 0.98
  },
  "gesture": {
   "drag-threshold-px": 8,
   "flick-dismiss-velocity": 0.11,
   "projection-deceleration": 0.998,
   "rubberband-constant": 0.55
  },
  "reduced": {
   "_rule": "prefers-reduced-motion: no translate or scale; sheets and toasts cross-fade",
   "fade": "200ms ease"
  }
 },
 "layout": {
  "breakpoints": {
   "sm": 640,
   "md": 768,
   "lg": 1024,
   "xl": 1280
  },
  "gutter-phone": 16,
  "header": 56,
  "tabbar": 56,
  "sidebar": 232,
  "content-max": 1180,
  "rail": 300,
  "sheet-detents": {
   "phone": [
    0.6,
    1.0
   ],
   "_note": "fractions of 92dvh; desktop = right panel min(560px, 44vw)"
  },
  "touch-target-min": 44,
  "chip-height": 36,
  "control-height": 36,
  "row-min": 48
 },
 "register": {
  "_about": "Gauge's 13-slot topic register on cards (D024): one fixed slot per topic id, filled with the topic glyph in topic ink; empty slot is a 3px dot in border-strong.",
  "slot": 12,
  "gap": 2,
  "glyph": 10,
  "empty-dot": 3,
  "max-named": 2
 }
